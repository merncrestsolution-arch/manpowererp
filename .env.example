# Database (PostgreSQL via Docker Compose — port 5435)
DATABASE_URL="postgresql://jk:jk_local_dev@localhost:5435/jk_manpower_erp?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Session (seconds)
SESSION_IDLE_TIMEOUT_SECONDS="1800"
SESSION_REMEMBER_ME_SECONDS="2592000"

# Email (Nodemailer SMTP) — omitted in dev logs reset links to console
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
EMAIL_FROM="noreply@jkmanpower.local"

# UploadThing (later phases)
UPLOADTHING_SECRET="replace-with-uploadthing-secret"
UPLOADTHING_APP_ID="replace-with-uploadthing-app-id"
