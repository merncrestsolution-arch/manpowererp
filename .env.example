# Database — local Docker Compose (port 5435) or Supabase Postgres
# Local:
DATABASE_URL="postgresql://jk:jk_local_dev@localhost:5435/jk_manpower_erp?schema=public"
DIRECT_URL="postgresql://jk:jk_local_dev@localhost:5435/jk_manpower_erp?schema=public"
# Supabase (production / Vercel):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Session (seconds)
SESSION_IDLE_TIMEOUT_SECONDS="1800"
SESSION_REMEMBER_ME_SECONDS="2592000"

# Email (Nodemailer SMTP) — omitted in dev logs reset links to console
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
EMAIL_FROM="noreply@jkmanpower.local"

# UploadThing (later phases)
UPLOADTHING_SECRET="replace-with-uploadthing-secret"
UPLOADTHING_APP_ID="replace-with-uploadthing-app-id"
UPLOADTHING_TOKEN="replace-with-uploadthing-token"

# Android APK download (optional override; otherwise uses Company Settings URL)
MOBILE_APK_URL=""

# Vercel production — set these in the Vercel project Environment Variables:
# DATABASE_URL          Supabase pooler URI (required)
# DIRECT_URL            Supabase direct URI (required for migrations)
# AUTH_SECRET           random 32+ character secret (required)
# NEXTAUTH_SECRET       same value as AUTH_SECRET
# AUTH_URL              https://your-domain.vercel.app
# NEXTAUTH_URL          same as AUTH_URL
# MOBILE_APK_URL        public HTTPS URL to the Android APK
# If you use the Vercel ↔ Supabase integration, POSTGRES_PRISMA_URL and
# POSTGRES_URL_NON_POOLING are mapped automatically.
