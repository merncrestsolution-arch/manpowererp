generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  FINANCE_MANAGER
  RECRUITER
  EMPLOYEE
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeDocumentType {
  CV
  NIC_COPY
  CERTIFICATE
  CONTRACT
  OTHER
}

enum LeaveType {
  ANNUAL
  CASUAL
  SICK
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  name          String
  role          Role      @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  image         String?
  branchId      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch              Branch?          @relation(fields: [branchId], references: [id])
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  approvedLeaveRequests LeaveRequest[] @relation("LeaveApprover")
  conductedInterviews Interview[]
  enteredAttendanceRecords AttendanceRecord[] @relation("AttendanceEnteredBy")
  approvedOvertimeRecords OvertimeRecord[] @relation("OvertimeApprover")
  paidExpenses            Expense[]          @relation("ExpensePaidBy")
  approvedExpenses        Expense[]          @relation("ExpenseApprover")
  recordedPayments        Payment[]          @relation("PaymentRecordedBy")
  postedJournals          Journal[]          @relation("JournalPostedBy")
  auditLogs               AuditLog[]
  triggeredBackups        BackupRecord[]     @relation("BackupTriggeredBy")
  deviceTokens            DeviceToken[]
  appNotifications        AppNotification[]

  @@index([email])
  @@index([deletedAt])
  @@index([role])
  @@index([branchId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id   String @id @default(cuid())
  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branches Branch[]
  companySettings CompanySettings?
  backupRecords   BackupRecord[]

  @@index([deletedAt])
}

model Branch {
  id             String @id @default(cuid())
  organizationId String
  name           String
  code           String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  employees    Employee[]
  shifts       Shift[]
  sequences    Sequence[]
  clients      Client[]
  jobOpenings  JobOpening[]
  candidates   Candidate[]
  deployments     Deployment[]
  payrollPeriods  PayrollPeriod[]
  salaryComponents SalaryComponent[]
  payslips        Payslip[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  quotations        Quotation[]
  invoices          Invoice[]
  payments          Payment[]
  chartAccounts     ChartAccount[]
  journals          Journal[]
  ledgerEntries     LedgerEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([deletedAt])
}

enum DevicePlatform {
  ANDROID
  IOS
}

model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppNotification {
  id     String  @id @default(cuid())
  userId String
  title  String
  body   String  @db.Text
  type   String
  data   Json?
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Sequence {
  id        String   @id @default(cuid())
  branchId  String
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, key])
  @@index([branchId])
}

model Employee {
  id             String           @id @default(cuid())
  branchId       String
  employeeNo     String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  nic            String?
  dateOfBirth    DateTime?
  gender         Gender?
  address        String?          @db.Text
  department     String?
  designation    String?
  employmentType EmploymentType   @default(PERMANENT)
  status         EmployeeStatus   @default(ACTIVE)
  joinedAt       DateTime?
  basicSalary    Decimal?         @db.Decimal(12, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch    Branch             @relation(fields: [branchId], references: [id])
  documents EmployeeDocument[]
  leaves    LeaveRequest[]
  shifts    EmployeeShift[]
  clientAssignments ClientWorkerAssignment[]
  deployments       Deployment[]
  placedFromCandidate Candidate? @relation("PlacedEmployee")
  attendanceRecords       AttendanceRecord[]
  overtimeRecords         OvertimeRecord[]
  salaryComponentAssignments EmployeeSalaryComponent[]
  payslips                Payslip[]

  @@unique([branchId, employeeNo])
  @@index([branchId])
  @@index([deletedAt])
  @@index([status])
  @@index([department])
  @@index([designation])
  @@index([employmentType])
  @@index([email])
  @@index([nic])
  @@index([firstName, lastName])
  @@index([branchId, status, deletedAt])
}

model EmployeeDocument {
  id         String               @id @default(cuid())
  employeeId String
  type       EmployeeDocumentType
  fileUrl    String
  fileName   String
  uploadedAt DateTime             @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([deletedAt])
  @@index([type])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String      @db.Text
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([deletedAt])
  @@index([startDate])
  @@index([employeeId, status])
}

model Shift {
  id        String @id @default(cuid())
  name      String
  startTime String
  endTime   String
  branchId  String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch      Branch       @relation(fields: [branchId], references: [id])
  employees   EmployeeShift[]
  deployments Deployment[]

  @@index([branchId])
  @@index([deletedAt])
}

model EmployeeShift {
  id            String    @id @default(cuid())
  employeeId    String
  shiftId       String
  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@index([employeeId])
  @@index([shiftId])
  @@index([effectiveFrom])
  @@index([deletedAt])
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum ClientContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum ClientWorkerAssignmentStatus {
  ACTIVE
  ENDED
}

enum ClientBillingStatus {
  PENDING
  INVOICED
  PAID
}

model Client {
  id             String       @id @default(cuid())
  branchId       String
  clientNo       String
  companyName    String
  registrationNo String?
  industry       String?
  address        String?      @db.Text
  city           String?
  status         ClientStatus @default(ACTIVE)
  creditTermDays Int          @default(30)
  notes          String?      @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch      Branch                   @relation(fields: [branchId], references: [id])
  contacts    ClientContact[]
  contracts   ClientContract[]
  assignments   ClientWorkerAssignment[]
  billing       ClientBillingRecord[]
  jobOpenings   JobOpening[]
  workLocations WorkLocation[]
  deployments   Deployment[]
  quotations    Quotation[]
  invoices      Invoice[]

  @@unique([branchId, clientNo])
  @@index([branchId])
  @@index([deletedAt])
  @@index([status])
  @@index([industry])
  @@index([companyName])
  @@index([city])
}

model ClientContact {
  id          String  @id @default(cuid())
  clientId    String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([deletedAt])
  @@index([isPrimary])
}

model ClientContract {
  id         String               @id @default(cuid())
  branchId   String
  clientId   String
  contractNo String
  title      String
  startDate  DateTime
  endDate    DateTime
  status     ClientContractStatus @default(DRAFT)
  fileUrl    String?
  terms      String?              @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@unique([branchId, contractNo])
  @@index([clientId])
  @@index([branchId])
  @@index([status])
  @@index([endDate])
  @@index([deletedAt])
}

model ClientWorkerAssignment {
  id           String                       @id @default(cuid())
  clientId     String
  employeeId   String
  assignedFrom DateTime
  assignedTo   DateTime?
  role         String
  status       ClientWorkerAssignmentStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id])
  deployment Deployment?

  @@index([clientId])
  @@index([employeeId])
  @@index([status])
  @@index([assignedFrom])
  @@index([deletedAt])
}

enum WorkLocationStatus {
  ACTIVE
  INACTIVE
}

enum DeploymentStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model WorkLocation {
  id       String             @id @default(cuid())
  clientId String
  name     String
  address  String?            @db.Text
  city     String?
  geoLat   Decimal?           @db.Decimal(10, 7)
  geoLng   Decimal?           @db.Decimal(10, 7)
  status   WorkLocationStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deployments   Deployment[]
  qrCheckpoints QrCheckpoint[]

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
  @@index([name])
}

enum AttendanceCheckMethod {
  QR
  GPS
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRecord {
  id             String                @id @default(cuid())
  employeeId     String
  deploymentId   String?
  date           DateTime
  checkInAt      DateTime?
  checkOutAt     DateTime?
  checkInMethod  AttendanceCheckMethod?
  checkOutMethod AttendanceCheckMethod?
  checkInLat     Decimal?              @db.Decimal(10, 7)
  checkInLng     Decimal?              @db.Decimal(10, 7)
  checkOutLat    Decimal?              @db.Decimal(10, 7)
  checkOutLng    Decimal?              @db.Decimal(10, 7)
  status         AttendanceStatus      @default(ABSENT)
  enteredById    String?
  manualReason   String?               @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deployment Deployment?       @relation(fields: [deploymentId], references: [id])
  enteredBy  User?             @relation("AttendanceEnteredBy", fields: [enteredById], references: [id])
  overtime   OvertimeRecord[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([deploymentId])
  @@index([date])
  @@index([status])
  @@index([enteredById])
  @@index([deletedAt])
}

model OvertimeRecord {
  id                 String         @id @default(cuid())
  attendanceRecordId String
  employeeId         String
  hours              Decimal        @db.Decimal(6, 2)
  rateMultiplier     Decimal        @default(1.5) @db.Decimal(4, 2)
  approvedById       String?
  status             OvertimeStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy       User?            @relation("OvertimeApprover", fields: [approvedById], references: [id])

  @@index([attendanceRecordId])
  @@index([employeeId])
  @@index([status])
  @@index([approvedById])
}

model QrCheckpoint {
  id             String    @id @default(cuid())
  workLocationId String
  code           String    @unique
  isActive       Boolean   @default(true)
  expiresAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  workLocation WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Cascade)

  @@index([workLocationId])
  @@index([isActive])
  @@index([expiresAt])
}

model Deployment {
  id                       String           @id @default(cuid())
  branchId                 String
  deploymentNo             String
  employeeId               String
  clientId                 String
  workLocationId           String
  shiftId                  String
  clientWorkerAssignmentId String?          @unique
  contractRefId            String?
  startDate                DateTime
  endDate                  DateTime?
  status                   DeploymentStatus @default(SCHEDULED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch                 Branch                  @relation(fields: [branchId], references: [id])
  employee               Employee                @relation(fields: [employeeId], references: [id])
  client                 Client                  @relation(fields: [clientId], references: [id])
  workLocation           WorkLocation            @relation(fields: [workLocationId], references: [id])
  shift                  Shift                   @relation(fields: [shiftId], references: [id])
  clientWorkerAssignment ClientWorkerAssignment? @relation(fields: [clientWorkerAssignmentId], references: [id])
  contractRef            ClientContract?         @relation(fields: [contractRefId], references: [id])
  contracts              DeploymentContract[]
  attendanceRecords      AttendanceRecord[]

  @@unique([branchId, deploymentNo])
  @@index([branchId])
  @@index([employeeId])
  @@index([clientId])
  @@index([workLocationId])
  @@index([shiftId])
  @@index([contractRefId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
}

model DeploymentContract {
  id           String    @id @default(cuid())
  deploymentId String
  fileUrl      String
  title        String
  signedAt     DateTime?
  expiresAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([expiresAt])
  @@index([deletedAt])
}

model ClientBillingRecord {
  id          String              @id @default(cuid())
  clientId    String
  periodStart DateTime
  periodEnd   DateTime
  amount      Decimal             @db.Decimal(12, 2)
  status      ClientBillingStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([periodStart])
  @@index([deletedAt])
}

enum JobOpeningStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum CandidateSource {
  WEBSITE
  REFERRAL
  AGENCY
  WALK_IN
  OTHER
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  PLACED
  REJECTED
  WITHDRAWN
}

enum InterviewMode {
  IN_PERSON
  PHONE
  VIDEO
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

model JobOpening {
  id                 String           @id @default(cuid())
  branchId           String
  title              String
  department         String?
  clientId           String?
  positionsAvailable Int              @default(1)
  status             JobOpeningStatus @default(OPEN)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch     Branch      @relation(fields: [branchId], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id])
  candidates Candidate[]

  @@index([branchId])
  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

model Candidate {
  id                String          @id @default(cuid())
  branchId          String
  candidateNo       String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  nic               String?
  jobOpeningId      String
  appliedFor        String?
  source            CandidateSource @default(OTHER)
  resumeUrl         String?
  status            CandidateStatus @default(APPLIED)
  placedEmployeeId  String?         @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch          Branch                   @relation(fields: [branchId], references: [id])
  jobOpening      JobOpening               @relation(fields: [jobOpeningId], references: [id])
  placedEmployee  Employee?                @relation("PlacedEmployee", fields: [placedEmployeeId], references: [id])
  interviews      Interview[]
  statusHistory   CandidateStatusHistory[]

  @@unique([branchId, candidateNo])
  @@index([branchId])
  @@index([jobOpeningId])
  @@index([status])
  @@index([source])
  @@index([deletedAt])
  @@index([firstName, lastName])
  @@index([email])
}

model Interview {
  id            String           @id @default(cuid())
  candidateId   String
  scheduledAt   DateTime
  interviewerId String
  mode          InterviewMode    @default(IN_PERSON)
  notes         String?          @db.Text
  outcome       InterviewOutcome @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer User      @relation(fields: [interviewerId], references: [id])

  @@index([candidateId])
  @@index([interviewerId])
  @@index([scheduledAt])
  @@index([deletedAt])
}

model CandidateStatusHistory {
  id          String           @id @default(cuid())
  candidateId String
  fromStatus  CandidateStatus?
  toStatus    CandidateStatus
  changedBy   String
  changedAt   DateTime         @default(now())
  remarks     String?          @db.Text

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([changedAt])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model ExpenseCategory {
  id          String  @id @default(cuid())
  branchId    String
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch   Branch    @relation(fields: [branchId], references: [id])
  expenses Expense[]

  @@index([branchId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([name])
}

model Expense {
  id              String        @id @default(cuid())
  branchId        String
  expenseNo       String
  categoryId      String
  description     String        @db.Text
  amount          Decimal       @db.Decimal(12, 2)
  expenseDate     DateTime
  paidById        String
  receiptUrl      String?
  status          ExpenseStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?       @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch          Branch                   @relation(fields: [branchId], references: [id])
  category        ExpenseCategory          @relation(fields: [categoryId], references: [id])
  paidBy          User                     @relation("ExpensePaidBy", fields: [paidById], references: [id])
  approvedBy      User?                    @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvalHistory ExpenseApprovalHistory[]

  @@unique([branchId, expenseNo])
  @@index([branchId])
  @@index([categoryId])
  @@index([paidById])
  @@index([approvedById])
  @@index([status])
  @@index([expenseDate])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt])
}

model ExpenseApprovalHistory {
  id         String         @id @default(cuid())
  expenseId  String
  fromStatus ExpenseStatus?
  toStatus   ExpenseStatus
  changedBy  String
  changedAt  DateTime       @default(now())
  remarks    String?        @db.Text

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([changedAt])
}

enum PayrollPeriodStatus {
  DRAFT
  PROCESSING
  FINALIZED
  PAID
}

enum SalaryComponentType {
  ALLOWANCE
  DEDUCTION
}

enum SalaryCalculationType {
  FIXED
  PERCENTAGE_OF_BASIC
}

enum PayslipStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayslipLineItemType {
  BASIC
  ALLOWANCE
  DEDUCTION
  OVERTIME
}

model PayrollPeriod {
  id          String              @id @default(cuid())
  branchId    String
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime
  status      PayrollPeriodStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch   Branch    @relation(fields: [branchId], references: [id])
  payslips Payslip[]

  @@index([branchId])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([deletedAt])
}

model SalaryComponent {
  id              String                @id @default(cuid())
  branchId        String
  name            String
  type            SalaryComponentType
  calculationType SalaryCalculationType
  defaultValue    Decimal               @db.Decimal(12, 2)
  isTaxable       Boolean               @default(false)
  isActive        Boolean               @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch              Branch                    @relation(fields: [branchId], references: [id])
  employeeAssignments EmployeeSalaryComponent[]

  @@index([branchId])
  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
}

model EmployeeSalaryComponent {
  id                String    @id @default(cuid())
  employeeId        String
  salaryComponentId String
  value             Decimal?  @db.Decimal(12, 2)
  effectiveFrom     DateTime
  effectiveTo       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@index([employeeId])
  @@index([salaryComponentId])
  @@index([effectiveFrom])
  @@index([deletedAt])
}

model Payslip {
  id              String        @id @default(cuid())
  branchId        String
  payslipNo       String
  payrollPeriodId String
  employeeId      String
  basicSalary     Decimal       @db.Decimal(12, 2)
  totalAllowances Decimal       @db.Decimal(12, 2)
  totalDeductions Decimal       @db.Decimal(12, 2)
  overtimePay     Decimal       @default(0) @db.Decimal(12, 2)
  grossSalary     Decimal       @db.Decimal(12, 2)
  netSalary       Decimal       @db.Decimal(12, 2)
  status          PayslipStatus @default(DRAFT)
  pdfUrl          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch        Branch            @relation(fields: [branchId], references: [id])
  payrollPeriod PayrollPeriod     @relation(fields: [payrollPeriodId], references: [id])
  employee      Employee          @relation(fields: [employeeId], references: [id])
  lineItems     PayslipLineItem[]

  @@unique([branchId, payslipNo])
  @@unique([payrollPeriodId, employeeId])
  @@index([branchId])
  @@index([payrollPeriodId])
  @@index([employeeId])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt])
  @@index([employeeId, status])
}

model PayslipLineItem {
  id        String              @id @default(cuid())
  payslipId String
  label     String
  type      PayslipLineItemType
  amount    Decimal             @db.Decimal(12, 2)
  isTaxable Boolean             @default(false)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  OTHER
}

model Quotation {
  id          String          @id @default(cuid())
  branchId    String
  quotationNo String
  clientId    String
  issueDate   DateTime
  validUntil  DateTime
  status      QuotationStatus @default(DRAFT)
  subtotal    Decimal         @db.Decimal(12, 2)
  taxAmount   Decimal         @db.Decimal(12, 2)
  total       Decimal         @db.Decimal(12, 2)
  notes       String?         @db.Text
  pdfUrl      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch    Branch              @relation(fields: [branchId], references: [id])
  client    Client              @relation(fields: [clientId], references: [id])
  lineItems QuotationLineItem[]
  invoices  Invoice[]

  @@unique([branchId, quotationNo])
  @@index([branchId])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([deletedAt])
}

model QuotationLineItem {
  id          String  @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Invoice {
  id          String        @id @default(cuid())
  branchId    String
  invoiceNo   String
  clientId    String
  quotationId String?
  issueDate   DateTime
  dueDate     DateTime
  status      InvoiceStatus @default(DRAFT)
  subtotal    Decimal       @db.Decimal(12, 2)
  taxAmount   Decimal       @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  amountDue   Decimal       @db.Decimal(12, 2)
  notes       String?       @db.Text
  pdfUrl      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch    Branch            @relation(fields: [branchId], references: [id])
  client    Client            @relation(fields: [clientId], references: [id])
  quotation Quotation?        @relation(fields: [quotationId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([branchId, invoiceNo])
  @@index([branchId])
  @@index([clientId])
  @@index([quotationId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt])
  @@index([branchId, dueDate])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(cuid())
  branchId     String
  paymentNo    String
  invoiceId    String
  amount       Decimal       @db.Decimal(12, 2)
  paymentDate  DateTime
  method       PaymentMethod
  reference    String?
  recordedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  branch     Branch  @relation(fields: [branchId], references: [id])
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@unique([branchId, paymentNo])
  @@index([branchId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([recordedById])
}

enum ChartAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum LedgerSourceType {
  PAYROLL
  EXPENSE
  INVOICE
  PAYMENT
  MANUAL
}

model ChartAccount {
  id              String           @id @default(cuid())
  branchId        String
  code            String
  name            String
  type            ChartAccountType
  parentAccountId String?
  isActive        Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branch        Branch         @relation(fields: [branchId], references: [id])
  parentAccount ChartAccount?  @relation("ChartAccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts ChartAccount[] @relation("ChartAccountHierarchy")
  ledgerEntries LedgerEntry[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([type])
  @@index([parentAccountId])
  @@index([isActive])
  @@index([deletedAt])
}

model Journal {
  id          String        @id @default(cuid())
  branchId    String
  reference   String
  date        DateTime
  description String        @db.Text
  postedById  String
  status      JournalStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  branch        Branch        @relation(fields: [branchId], references: [id])
  postedBy      User          @relation("JournalPostedBy", fields: [postedById], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([branchId])
  @@index([date])
  @@index([status])
  @@index([postedById])
}

model LedgerEntry {
  id          String           @id @default(cuid())
  branchId    String
  accountId   String
  entryDate   DateTime
  description String           @db.Text
  debit       Decimal          @default(0) @db.Decimal(14, 2)
  credit      Decimal          @default(0) @db.Decimal(14, 2)
  sourceType  LedgerSourceType
  sourceId    String
  journalId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  branch  Branch       @relation(fields: [branchId], references: [id])
  account ChartAccount @relation(fields: [accountId], references: [id])
  journal Journal      @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([branchId, sourceType, sourceId])
  @@index([branchId])
  @@index([accountId])
  @@index([journalId])
  @@index([entryDate])
  @@index([branchId, accountId, entryDate])
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
}

model CompanySettings {
  id             String  @id @default(cuid())
  organizationId String  @unique
  name           String
  registrationNo String?
  address        String? @db.Text
  city           String?
  phone          String?
  email          String?
  logoUrl        String?
  taxId          String?
  fiscalYearStart Int    @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([deletedAt])
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  module      String
  description String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String  @id @default(cuid())
  role         Role
  permissionId String
  isGranted    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  branchId       String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@index([organizationId])
  @@index([branchId])
}

model BackupRecord {
  id              String       @id @default(cuid())
  organizationId  String
  triggeredById   String
  status          BackupStatus @default(PENDING)
  fileSize        Int?
  storageLocation String?
  completedAt     DateTime?
  errorMessage    String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  organization Organization @relation(fields: [organizationId], references: [id])
  triggeredBy  User         @relation("BackupTriggeredBy", fields: [triggeredById], references: [id])

  @@index([organizationId])
  @@index([triggeredById])
  @@index([status])
  @@index([createdAt])
}
